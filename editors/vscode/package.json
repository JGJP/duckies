{
	"name": "duckies-syntax",
	"displayName": "duckies (.dk)",
	"description": "Syntax highlighting for duckies .dk control files",
	"version": "0.1.0",
	"publisher": "duckies",
	"license": "MIT",
	"engines": {
		"vscode": "^1.75.0"
	},
	"categories": [
		"Programming Languages"
	],
	"contributes": {
		"languages": [
			{
				"id": "duckies",
				"aliases": [
					"duckies"
				],
				"extensions": [
					".dk"
				],
				"configuration": "./language-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "duckies",
				"scopeName": "source.duckies",
				"path": "./syntaxes/duckies.tmLanguage.json"
			}
		],
		"configurationDefaults": {
			"editor.tokenColorCustomizations": {
				"textMateRules": [
					{
						"scope": "markup.other.shownow.duckies",
						"settings": { "foreground": "#000000", "background": "#FFFFFF" }
					},
					{
						"scope": "markup.other.clear.duckies",
						"settings": { "foreground": "#000000", "background": "#FFE600" }
					},
					{
						"scope": "markup.other.sleep.duckies",
						"settings": { "foreground": "#666666" }
					},
					{
						"scope": "markup.other.waiting.duckies",
						"settings": { "foreground": "#000000", "background": "#33C6FF" }
					},
					{
						"scope": "entity.name.function.widget.duckies, markup.other.widget.output.duckies",
						"settings": { "foreground": "#FFFFFF", "background": "#333333" }
					},
					{
						"scope": "markup.other.directive.duckies",
						"settings": { "foreground": "#FFFFFF", "background": "#8B5CF6" }
					}
				]
			}
		}
	}
}
