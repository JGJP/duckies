{
	"name": "herald-syntax",
	"displayName": "herald (.herald)",
	"description": "Syntax highlighting for herald .herald control files",
	"version": "0.1.0",
	"publisher": "herald",
	"license": "MIT",
	"engines": {
		"vscode": "^1.75.0"
	},
	"categories": [
		"Programming Languages"
	],
	"contributes": {
		"languages": [
			{
				"id": "herald",
				"aliases": [
					"herald"
				],
				"extensions": [
					".herald"
				],
				"configuration": "./language-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "herald",
				"scopeName": "source.herald",
				"path": "./syntaxes/herald.tmLanguage.json"
			}
		],
		"configurationDefaults": {
			"editor.tokenColorCustomizations": {
				"textMateRules": [
					{
						"scope": "markup.other.shownow.herald",
						"settings": { "foreground": "#000000", "background": "#FFFFFF" }
					},
					{
						"scope": "markup.other.clear.herald",
						"settings": { "foreground": "#000000", "background": "#FFE600" }
					},
					{
						"scope": "markup.other.waiting.herald",
						"settings": { "foreground": "#000000", "background": "#33C6FF" }
					},
					{
						"scope": "entity.name.function.widget.herald, markup.other.widget.output.herald",
						"settings": { "foreground": "#FFFFFF", "background": "#333333" }
					}
				]
			}
		}
	}
}
