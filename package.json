{
	"name": "duckies",
	"version": "1.0.0",
	"description": "Run and control many interactive Claude Code instances in tmux through plain-text .dk files.",
	"license": "MIT",
	"author": "J Garcia",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://codeberg.org/setter/duckies.git"
	},
	"homepage": "https://codeberg.org/setter/duckies",
	"bugs": {
		"url": "https://codeberg.org/setter/duckies/issues"
	},
	"keywords": [
		"claude",
		"claude-code",
		"tmux",
		"agent",
		"orchestration",
		"tui",
		"supervisor"
	],
	"engines": {
		"node": ">=18"
	},
	"packageManager": "pnpm@11.8.0",
	"scripts": {
		"start": "tsx duckies-run.ts",
		"restart": "tsc --noEmit && tsx duckies-restart.ts",
		"duckies": "tsx tui.ts",
		"dry-run": "tsx duckies.ts --dry-run",
		"setup": "tsx setup.ts",
		"test": "tsx test.ts",
		"type-check": "tsc --noEmit"
	},
	"devDependencies": {
		"@jgjp/fire": "1.0.0",
		"@types/node": "24.13.3",
		"tsx": "4.23.1",
		"typescript": "5.9.3",
		"zod": "4.4.3",
		"zx": "8.8.5"
	},
	"dependencies": {
		"@typesafe-ai/sdk": "^0.6.0",
		"node-diff3": "^3.2.1"
	}
}
