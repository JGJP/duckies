%YAML 1.2
---
# Syntax for duckies `.dk` control files. Grammar mirrors parse() in
# duckies.ts: column-0 lines are session headers, tab-indented lines are queue
# items (prompt / $command / show / [status marker]); `#` rows are comments. Scopes map to
# standard TextMate scopes so any color scheme lights them up for free.
name: duckies
scope: source.duckies
version: 2

file_extensions:
  - dk
  - .dk

contexts:
  main:
    # Show-now line: any line whose first non-tab char is `!` reveals its pane/session now.
    # Matched before every item rule so the whole line reads as one scope the color scheme
    # flags (black on white), overriding the per-item coloring below — this is the only form
    # of `!` duckies recognises. A `!` anywhere else in a line is ordinary text.
    - match: '^[ \t]*!.*$'
      scope: markup.other.shownow.duckies

    # Sleep scope: a header or worktree label whose first non-tab char is `?` is slept (duckies tears
    # its tmux down but keeps the conversation). Grey the WHOLE scope — the `?` line and every line
    # indented deeper than it — so the dormant block reads as inactive. `\1` captures the `?` line's
    # indent; the pushed context greys each line until one not indented past it (the next sibling /
    # header), mirroring parse()'s cascade. Matched before the item/label rules; no sigil starts `?`.
    - match: '^(\t*)\?.*$\n?'
      scope: markup.other.sleep.duckies
      push:
        - meta_content_scope: markup.other.sleep.duckies
        - match: '^(?!\1\t)'
          pop: true
        # A `#` row inside a slept block is still a comment: carry the comment scope so tooling
        # keyed off the `comment` selector (e.g. GOTO anchor detection) still sees it, with the
        # sleep scope trailing (most specific) so the scheme keeps painting it dormant-grey.
        - match: '^[ \t]*((#)[^\n]*)$\n?'
          captures:
            1: comment.line.number-sign.duckies markup.other.sleep.duckies
            2: punctuation.definition.comment.duckies markup.other.sleep.duckies
        - match: '.*\n?'
          scope: markup.other.sleep.duckies

    # Comment: any row starting with `#` (at any indent, incl. column 0) is ignored.
    - match: '^[ \t]*((#)[^\n]*)$'
      captures:
        1: comment.line.number-sign.duckies
        2: punctuation.definition.comment.duckies

    # Macro call: a `@name [args]` line the controller expands to a reusable block (see
    # duckies-macros.yaml). A name char must follow the `@`, so a `@@@…` body line never
    # matches. The whole call reads as one unit (function scope → green, see the color scheme).
    - match: '^[ \t]*(@[\w-]+(?:[ \t].*)?)$'
      captures:
        1: entity.name.function.macro.duckies

    # Template call: a `>name [args]` line the controller PASTES — it physically replaces this
    # line in the file with the named body (see duckies-templates.yaml), so the injected rows become
    # ordinary visible items. A name char must follow the `>` (so a `->` note never matches); matched
    # before the worktree fallback so `>name` isn't read as a label. Magenta (its own function scope).
    - match: '^[ \t]*(>[\w-]+(?:[ \t].*)?)$'
      captures:
        1: entity.name.function.template.duckies

    # DUCKIES directive: a `DUCKIES: <text>` line runs a background agent to edit the `.dk` files
    # themselves (see the duckies pass in duckies.ts). Case-sensitive `DUCKIES:` so ordinary prose never
    # trips it. Matched before the worktree fallback so it isn't read as a label; a distinct color
    # marks it as a meta-command. The whole line reads as one unit.
    - match: '^[ \t]*(DUCKIES:.*)$'
      captures:
        1: markup.other.directive.duckies

    # Widget call: a `&name [args]` line — a status display, mirroring its output below as `| `
    # lines (see duckies-widgets.yaml). A single `&` runs once; `&&` reruns on the widget's interval.
    # The `&name` line and the `| ` output lines directly under it form one block, painted
    # white-on-dark-grey by the color scheme. Pushing a context lets the output `| ` lines carry
    # their own scope so a *prompt* body `|` (below) stays untouched. The block ends at the first
    # line that isn't a `| ` continuation.
    - match: '^[ \t]*(&+[\w-]+(?:[ \t:].*)?)$'
      captures:
        1: entity.name.function.widget.duckies
      push:
        # Scope the output text plus the ONE extra indent tab it sits under (output is always one
        # level deeper than its `&name`), so the grey background starts at the same column as the
        # `&name` above and the two read as one connected block. The widget-depth tabs before that
        # (`\t*`) stay bare, matching the `&name` line whose capture excludes its own indent.
        - match: '^\t*(\t[ ]*\|.*)$'
          captures:
            1: markup.other.widget.output.duckies
        - match: '^(?!\t+[ ]*\|)'
          pop: true

    # Prompt: `prompt:` or the `:` shorthand. A run of colons or a trailing number
    # (`::`/`:2`) selects the lane/pane. The whole line is one prompt scope (sigil +
    # text) so it can be styled as a single unit. A leading `!` reveals this item's pane
    # now, handled by the show-now rule above.
    - match: '^\t+[ ]*((?i:prompt)?:+\d*)'
      captures:
        1: keyword.control.prompt.duckies
      push:
        - meta_content_scope: meta.prompt.duckies
        - match: $\n?
          pop: true

    # Multiline prompt body: a `|` line continues the prompt above it (YAML block-scalar
    # style). The `|` reads as a prompt sigil and the rest as prompt text, so a pasted body
    # is never mistaken for a worktree label.
    - match: '^\t+[ ]*(\|)(.*)$'
      captures:
        1: keyword.control.prompt.duckies
        2: meta.prompt.duckies

    # Command: `$` sigil runs in the shell window; `$$`/`$2` target lane 2, etc. Sigil and
    # text share a scope so the whole command reads blue (see the color scheme). A leading `!`
    # reveals the shell window now, handled by the show-now rule above.
    - match: '^\t+[ ]*(\$+\d*)(.*)$'
      captures:
        1: keyword.operator.command.duckies
        2: string.unquoted.command.duckies

    # Show item: a bare `show` (any case) or a bare `!` brings the session on screen.
    - match: '^\t+[ ]*(?i:(show|!))[ ]*$'
      captures:
        1: keyword.control.show.duckies

    # Clear item: a bare `%`/`%%`/`%N` collapses its lane's completed run below it (see parse()).
    # Matched before the worktree fallback so `%` isn't read as a label; the color scheme gives
    # it a yellow background so it stands out as an action marker.
    - match: '^\t+[ ]*(%+\d*)[ ]*$'
      captures:
        1: markup.other.clear.duckies

    # Status markers (controller-written). Each state gets its own scope so the
    # queue reads like a traffic light: executing = active, done = success,
    # attention / session-error = alarm. A leading `!` ("reveal now") is handled by the
    # show-now rule above.
    - match: '^\t+[ ]*((?i:\[[^\]]*executing[^\]]*\]))[ ]*$'
      captures:
        1: constant.language.executing.duckies
    - match: '^\t+[ ]*((?i:\[[^\]]*done[^\]]*\]))[ ]*$'
      captures:
        1: markup.inserted.done.duckies
    - match: '^\t+[ ]*((?i:\[[^\]]*attention[^\]]*\]))[ ]*$'
      captures:
        1: invalid.deprecated.attention.duckies
    # A failed `$command` (non-zero exit): the loudest alarm, since it halts the lane.
    - match: '^\t+[ ]*((?i:\[[^\]]*error[^\]]*\]))[ ]*$'
      captures:
        1: invalid.illegal.error.duckies
    # Turn ended, but backgrounded tasks will resume claude on their own: paused, not done.
    - match: '^\t+[ ]*((?i:\[[^\]]*waiting[^\]]*\]))[ ]*$'
      captures:
        1: markup.other.waiting.duckies
    # Anything else in brackets (e.g. [NO DIR …], [DUPLICATE]) is a session marker.
    - match: '^\t+[ ]*(\[[^\n]*\])[ ]*$'
      captures:
        1: invalid.illegal.marker.duckies

    # Note: a `-> …` line duckies mirrors below a finished prompt — an inert one-line summary
    # of the turn (see the note pass in parse()/buildOps). Matched before the worktree fallback
    # so the non-sigil line isn't read as a worktree label. Scoped as a comment so it inherits
    # the scheme's muted comment styling, matching the `#` rows above.
    - match: '^\t+[ ]*->.*$'
      scope: comment.line.note.duckies

    # Worktree label: a tab-indented, non-sigil line (a git worktree of the enclosing
    # repo). It matches none of the rules above, mirroring parse()'s fallback branch, and
    # reads as a class name — the same scope as the repo header it stands in for. A
    # leading `!` ("show now") is handled by the show-now rule above.
    - match: '^\t+[ ]*(\S[^\n]*?)[ ]*$'
      captures:
        1: entity.name.class.duckies

    # Session header: a column-0 line (no leading tab). A leading `!` means "switch to
    # this session now", handled by the show-now rule above.
    - match: '^(?![\t\n])[ ]*([^\n]*?)[ ]*$'
      captures:
        1: entity.name.class.duckies
