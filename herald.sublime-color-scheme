{
	// Merges into whatever color scheme is active (Sublime combines the `rules` of every
	// .sublime-color-scheme whose filename matches the active scheme). Colors the herald scopes a
	// syntax file alone can't reach — notably the backgrounds on status markers. Hexes are tuned to
	// the "J Dark Matrix" scheme; retune to taste. The `-> ` note line is scoped
	// `comment.line.note.herald` by the syntax, so it inherits the scheme's comment color for free
	// (no rule needed here). Drop alongside herald.sublime-syntax.
	"rules": [
		{
			"scope": "entity.name.function.macro.herald",
			"foreground": "#a6df95",
		},
		{
			"scope": "entity.name.function.widget.herald, markup.other.widget.output.herald",
			"foreground": "#ffffff",
			"background": "#333333",
		},
		{
			"scope": "keyword.operator.command.herald, string.unquoted.command.herald",
			"foreground": "#3399ff",
		},
		{
			"scope": "keyword.control.prompt.herald, meta.prompt.herald",
			"foreground": "#ffffff",
		},
		{
			"scope": "entity.name.class.herald",
			"foreground": "#ffffff",
			"font_style": "bold underline",
		},
		{
			"scope": "constant.language.executing.herald",
			"foreground": "#000000",
			"background": "#ff791a",
		},
		{
			"scope": "markup.inserted.done.herald, invalid.illegal.marker.herald",
			"foreground": "#ffffff",
			"background": "#dc0404",
		},
		{
			"scope": "invalid.deprecated.attention.herald",
			"foreground": "#000000",
			"background": "#ffcc00",
		},
		{
			"scope": "invalid.illegal.error.herald",
			"foreground": "#ffffff",
			"background": "#ff0000",
		},
		{
			"scope": "markup.other.waiting.herald",
			"foreground": "#000000",
			"background": "#33c6ff",
		},
		{
			"scope": "markup.other.shownow.herald",
			"foreground": "#000000",
			"background": "#ffffff",
		},
		{
			"scope": "markup.other.clear.herald",
			"foreground": "#000000",
			"background": "#ffe600",
		},
	],
}
